# PostgreSQL (Compose binds to localhost only; development password, not for production).
# Leave unset to run the explicitly labeled in-memory sample catalogue.
DATABASE_URL="postgresql://torob:torob_demo@localhost:5432/torob_bime?schema=public"

# Optional: BOTH are required for live Anthropic extraction, intent, and explanations.
# User search text is sent to Anthropic in this mode; the UI discloses this.
ANTHROPIC_API_KEY=""
LLM_MODEL=""

# Optional: point ONLY at a disposable migrated database to run persistence integration tests.
TEST_DATABASE_URL=""

# Optional Playwright overrides. Leave empty for the managed local dev server/browser.
PLAYWRIGHT_BASE_URL=""
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=""

# Advanced Prisma CLI binary overrides (usually unnecessary). Migrations require a REAL
# schema engine; do not point it to a dummy executable. Client generation uses JS engine.
# PRISMA_SCHEMA_ENGINE_BINARY=""
# PRISMA_QUERY_ENGINE_LIBRARY=""
