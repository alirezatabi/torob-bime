{
  "name": "torob-bime",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && npm run check:design",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/eval.ts",
    "ingest": "tsx scripts/ingest.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "add-type": "tsx scripts/add-insurance-type.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run eval",
    "postinstall": "prisma generate",
    "snapshot": "tsx scripts/snapshot.ts",
    "dev:lan": "next dev -H 0.0.0.0",
    "start:lan": "next start -H 0.0.0.0",
    "check:design": "node scripts/check-design-tokens.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@fontsource-variable/vazirmatn": "^5.2.8",
    "@next/env": "^16.4.6",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "lucide-react": "^0.468.0",
    "next": "^16.4.6",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
