{
  "name": "torob-bime",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "npm run db:generate && next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/eval.ts",
    "ingest": "tsx scripts/ingest.ts",
    "db:generate": "node scripts/generate-client.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "add-type": "tsx scripts/add-insurance-type.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run eval",
    "postinstall": "node scripts/generate-client.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@fontsource/vazirmatn": "5.3.0",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "lucide-react": "^0.468.0",
    "next": "15.5.29",
    "pg": "^8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
